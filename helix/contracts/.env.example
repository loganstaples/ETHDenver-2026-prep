# HELIX Contract Deployment Configuration
# Copy to .env and fill in values: cp .env.example .env

# ============ ADI Chain Testnet ============
# RPC endpoint for ADI Chain testnet
RPC_URL=

# Chain ID for ADI Chain testnet
CHAIN_ID=

# Block explorer URL (for contract verification)
ETHERSCAN_API_URL=
ETHERSCAN_API_KEY=

# ============ Deployer Configuration ============
# Private key of the deploying account (with 0x prefix)
PRIVATE_KEY=

# Treasury address for slashed funds and protocol fees
# Defaults to deployer address if not set
TREASURY=

# ============ Deployed Contract Addresses ============
# Fill these in after deployment (output from DeployAll.s.sol)
COORDINATOR_ADDRESS=
VERIFIER_ADDRESS=
MODEL_STORE_ADDRESS=
TOKEN_ADDRESS=
