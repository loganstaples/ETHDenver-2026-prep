# HELIX Dashboard Configuration
# Copy this file to .env.local and configure as needed

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL for REST endpoints (do NOT include /api — the code appends it)
# For LAN access from another machine, use the host machine's IP (e.g. http://192.168.1.50:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for real-time updates
# For LAN access, match the API URL host (e.g. ws://192.168.1.50:3001/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# =============================================================================
# Blockchain Configuration
# =============================================================================

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# Enable testnet support (set to 'true' for development)
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Default chain ID (31337 = Hardhat, 11155111 = Sepolia, 1 = Mainnet)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337

# =============================================================================
# Contract Addresses (override defaults if needed)
# =============================================================================

# Hardhat/Local addresses (default)
NEXT_PUBLIC_COORDINATOR_ADDRESS_31337=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_VERIFIER_ADDRESS_31337=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_TOKEN_ADDRESS_31337=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# ADI Network Testnet (chain 99999)
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=99999
# NEXT_PUBLIC_COORDINATOR_ADDRESS=0x45EF05ac69ea0064CD9037ef8F2A05e2D758F4A7
# NEXT_PUBLIC_MODEL_STORE_ADDRESS=
# NEXT_PUBLIC_RPC_URL=https://rpc.ab.testnet.adifoundation.ai

# Sepolia testnet addresses
# NEXT_PUBLIC_COORDINATOR_ADDRESS_11155111=
# NEXT_PUBLIC_VERIFIER_ADDRESS_11155111=
# NEXT_PUBLIC_TOKEN_ADDRESS_11155111=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable demo mode features (guided tour, sample data)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Enable debug logging for WebSocket
NEXT_PUBLIC_WS_DEBUG=false

# Enable mock data fallback when API unavailable
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# =============================================================================
# UI Configuration
# =============================================================================

# Refresh interval for training data (milliseconds)
NEXT_PUBLIC_TRAINING_REFRESH_INTERVAL=2000

# Refresh interval for proof data (milliseconds)
NEXT_PUBLIC_PROOF_REFRESH_INTERVAL=3000

# Refresh interval for node metrics (milliseconds)
NEXT_PUBLIC_NODE_REFRESH_INTERVAL=5000

# Maximum number of proofs to display
NEXT_PUBLIC_MAX_PROOFS_DISPLAY=100

# Maximum number of training history points
NEXT_PUBLIC_MAX_HISTORY_POINTS=500

# =============================================================================
# 0G Decentralized Storage (for trained model storage)
# =============================================================================

# Private key with 0G testnet tokens (get from https://faucet.0g.ai)
# ZG_PRIVATE_KEY=

# 0G Storage RPC and indexer (defaults to Galileo testnet)
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# =============================================================================
# IPFS Configuration (for model storage)
# =============================================================================

# IPFS Gateway URL
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Pinata API Key (for IPFS pinning)
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# =============================================================================
# Analytics (optional)
# =============================================================================

# Plausible Analytics domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# =============================================================================
# Development
# =============================================================================

# Node environment
NODE_ENV=development

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
