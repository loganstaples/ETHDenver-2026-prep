# ============================================================================
# HELIX ADI Testnet Configuration
# ============================================================================
# ADI Chain: EVM-compatible L2 (zkSync Atlas / zkStack)
# Docs: https://docs.adi.foundation/
# Faucet: https://faucet.ab.testnet.adifoundation.ai/
# Explorer: https://explorer.ab.testnet.adifoundation.ai/
# ============================================================================

# -- Network --
ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
ADI_CHAIN_ID=99999
ADI_EXPLORER=https://explorer.ab.testnet.adifoundation.ai/

# -- Owner wallet (fund this from the faucet) --
# IMPORTANT: Replace with your own private key after funding from faucet
TESTNET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# -- Pre-deployed contract addresses (filled by deploy-adi.sh) --
COORDINATOR_ADDRESS=
VERIFIER_ADDRESS=

# -- Worker seed (must match spawn-workers --seed, default 42) --
WORKER_SEED=42
