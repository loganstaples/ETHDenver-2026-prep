# HELIX Aggregator Docker Image
# ==============================
# Production-grade image for HELIX gradient aggregation and coordination nodes.
# Aggregators collect gradients from workers, verify proofs, and commit to chain.
#
# The aggregator runs with elevated resource limits for:
#   - High-throughput gradient collection
#   - Parallel proof verification
#   - On-chain transaction submission
#
# Usage:
#   docker build -t helix-aggregator -f Dockerfile.aggregator ../..
#   docker run -d --name aggregator -p 9000:9000 -p 9001:9001 helix-aggregator

# ==============================================================================
# Stage 1: Build dependencies cache
# ==============================================================================
FROM rust:1.75-bookworm AS chef

RUN cargo install cargo-chef --locked
WORKDIR /helix

# ==============================================================================
# Stage 2: Recipe creation
# ==============================================================================
FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY crates/helix-core/Cargo.toml crates/helix-core/
COPY crates/helix-avm/Cargo.toml crates/helix-avm/
COPY crates/helix-circuits/Cargo.toml crates/helix-circuits/
COPY crates/helix-prover/Cargo.toml crates/helix-prover/
COPY crates/helix-mpc/Cargo.toml crates/helix-mpc/
COPY crates/helix-node/Cargo.toml crates/helix-node/
COPY crates/helix-client/Cargo.toml crates/helix-client/

RUN mkdir -p crates/helix-core/src && echo "pub fn _dummy() {}" > crates/helix-core/src/lib.rs \
    && mkdir -p crates/helix-avm/src && echo "pub fn _dummy() {}" > crates/helix-avm/src/lib.rs \
    && mkdir -p crates/helix-circuits/src && echo "pub fn _dummy() {}" > crates/helix-circuits/src/lib.rs \
    && mkdir -p crates/helix-prover/src && echo "pub fn _dummy() {}" > crates/helix-prover/src/lib.rs \
    && mkdir -p crates/helix-mpc/src && echo "pub fn _dummy() {}" > crates/helix-mpc/src/lib.rs \
    && mkdir -p crates/helix-node/src && echo "fn main() {}" > crates/helix-node/src/main.rs \
    && mkdir -p crates/helix-client/src && echo "fn main() {}" > crates/helix-client/src/main.rs

RUN cargo chef prepare --recipe-path recipe.json

# ==============================================================================
# Stage 3: Dependency compilation
# ==============================================================================
FROM chef AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libclang-dev \
    clang \
    cmake \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY --from=planner /helix/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json -p helix-node

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

RUN rm -rf target/release/.fingerprint/helix-* \
    && rm -rf target/release/deps/helix* \
    && rm -rf target/release/deps/libhelix*

# Build with aggregator-specific features
RUN cargo build --release -p helix-node --features "aggregator"

RUN cp target/release/helix-node /helix-aggregator

# ==============================================================================
# Stage 4: Aggregator runtime image
# ==============================================================================
FROM debian:bookworm-slim AS runtime

LABEL org.opencontainers.image.title="HELIX Aggregator"
LABEL org.opencontainers.image.description="HELIX gradient aggregation and coordination node"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.vendor="HELIX Protocol"

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    jq \
    dumb-init \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/data /app/logs /app/config /app/keys /app/gradients /app/proofs

# Create helix user with appropriate permissions
RUN groupadd -r helix -g 1000 \
    && useradd -r -u 1000 -g helix -d /app -s /sbin/nologin helix \
    && chown -R helix:helix /app

COPY --from=builder /helix-aggregator /app/helix-aggregator
COPY scripts/docker/config/aggregator-default.toml /app/config/aggregator.toml
COPY scripts/docker/scripts/aggregator-entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/helix-aggregator /app/entrypoint.sh \
    && chown -R helix:helix /app

USER helix

# Environment for aggregator role
ENV RUST_LOG=info,helix_node=debug,helix_aggregator=debug
ENV RUST_BACKTRACE=1
ENV HELIX_DATA_DIR=/app/data
ENV HELIX_LOG_DIR=/app/logs
ENV HELIX_CONFIG_DIR=/app/config
ENV HELIX_GRADIENTS_DIR=/app/gradients
ENV HELIX_PROOFS_DIR=/app/proofs

# Aggregator-specific configuration
ENV HELIX_NODE_ROLE=aggregator
ENV HELIX_LISTEN_ADDR=0.0.0.0:9000
ENV HELIX_API_ADDR=0.0.0.0:9001
ENV HELIX_METRICS_ADDR=0.0.0.0:9002

# Aggregation settings
ENV HELIX_MIN_WORKERS=3
ENV HELIX_COLLECTION_TIMEOUT=120
ENV HELIX_VERIFICATION_PARALLELISM=4
ENV HELIX_BATCH_SUBMIT=true

# Ethereum settings (must be provided at runtime)
ENV HELIX_ETH_RPC=""
ENV HELIX_ETH_CHAIN_ID=31337
ENV HELIX_COORDINATOR_ADDRESS=""

# Exposed ports
EXPOSE 9000/tcp 9001/tcp 9002/tcp 5353/udp

# More aggressive health check for aggregator
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://localhost:9001/health && \
        curl -sf http://localhost:9001/aggregator/status | jq -e '.ready == true' || exit 1

VOLUME ["/app/data", "/app/logs", "/app/config", "/app/keys", "/app/gradients", "/app/proofs"]

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/app/entrypoint.sh"]
